# Root .env.example — values for docker-compose.yml interpolation
# Copy to .env and fill in real values. The .env file is git-ignored.

# ── Required ──────────────────────────────────────────────────────────────────
# Must be at least 32 random characters (enforced by Backend/config/env.js)
JWT_SECRET=replace_with_32_plus_random_chars_do_not_use_this_value

# ── Cloudinary (optional in development, required in production) ───────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
