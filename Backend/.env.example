PORT=5000
NODE_ENV=development
MONGO_URL=mongodb://localhost:27017/linkup
CLIENT_URL=http://localhost:3000
JWT_SECRET=your_random_secret_at_least_32_characters_long

# MongoDB connection pool size (optional, default 10)
# MONGO_MAX_POOL_SIZE=10

# Number of reverse proxies in front of app (e.g. 1 on Render/Heroku, 0 for direct/localhost)
# TRUST_PROXY=0

# Custom DNS servers for Node.js resolution (optional comma-separated list of IPs)
# DNS_SERVERS=8.8.8.8,8.8.4.4

# Redis (optional - falls back to direct MongoDB reads if unavailable)
# Note: REDIS_URL takes precedence over REDIS_HOST and REDIS_PORT when set
REDIS_URL=redis://localhost:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_COMMAND_TIMEOUT_MS=250
# REDIS_CONNECT_TIMEOUT_MS=2000

# Mount GET /api/v1/debug/ip endpoint (optional, default false)
# DEBUG_IP_ENDPOINT=false

# Cloudinary (for post media uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
